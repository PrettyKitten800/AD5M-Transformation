# Flashforge AD5M rebuild - CoreXY motion commissioning
# Commissioning with calibrated homing, native extrusion and bed meshing.
# Do not replace this with either guide's complete config unchanged.
# Reference review: /home/curby/printer-rebuild/README.md

[include mainsail.cfg]
[include bed-heater-check.cfg]
[include motion-check.cfg]
[include extruder.cfg]
[include calibration.cfg]
[include eddy-duo.cfg]
[include eddy-macros.cfg]
[include forge-x-macros.cfg]
[include printer-behavior.cfg]

[mcu]
canbus_uuid: c16b9f102b59
canbus_interface: can0

[mcu head]
canbus_uuid: 5f3949396f0c
canbus_interface: can0

[printer]
kinematics: corexy
max_velocity: 100
max_accel: 1500
max_z_velocity: 10
max_z_accel: 100

[temperature_sensor Raspberry_Pi_5]
sensor_type: temperature_host

[gcode_arcs]
resolution: 0.1

[exclude_object]

# Eddy Duo now supplies bed-probe readings; optical Z-max still homes Z.
# Read the EBB42 onboard accelerometer without commanding printer movement.
[adxl345]
cs_pin: head:PB12
spi_bus: spi2_PB2_PB11_PB10

# STOP4 runout input still needs a verified empty/loaded transition.
[filament_switch_sensor runout_sensor]
switch_pin: ^!PG12
pause_on_runout: False

# EBB42 FAN1 / PA0 part-cooling output.
[fan]
pin: head:PA0

# Octopus Pro FAN0, voltage jumper set to 24V.
[output_pin enclosure_lights]
pin: PA8
pwm: True
cycle_time: 0.001
value: 0.20
shutdown_value: 0

