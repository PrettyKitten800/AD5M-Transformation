# Fluidd/Mainsail macros for the BTT Eddy Duo (probe_eddy_current btt_eddy).
# Probe sits 44 mm right of the nozzle, so nozzle X100 Y110 puts the coil at
# X144 Y110 (the same spot used by temperature_probe calibration_position).
# Macros that change saved calibration need CONFIRM=1 and are idle-only.
# Heater-using macros must only be run while the printer is supervised.

[gcode_macro EDDY_STATUS]
description: Read-only Eddy Duo summary: temperatures, last probe Z, offsets, meshes
gcode:
    {% set cal = printer["temperature_probe btt_eddy"] %}
    {% set mcu = printer["temperature_sensor Eddy_MCU"] %}
    {% set homing_z = printer.gcode_move.homing_origin.z %}
    RESPOND MSG="{'Eddy coil %.1f C, Eddy MCU %.1f C | last probe Z: %.4f | G-code Z offset: %.3f | active mesh: %s | saved meshes: %s | homed: %s' % (cal.temperature, mcu.temperature, printer.probe.last_z_result, homing_z, printer.bed_mesh.profile_name or 'none', printer.bed_mesh.profiles.keys() | list | join(', ') or 'none', printer.toolhead.homed_axes or 'none')}"

[gcode_macro EDDY_PROBE_ACCURACY]
description: Repeatability test at bed center. Optional SAMPLES (default 10), BED_TEMP, EXTRUDER_TEMP (heated only if given, turned off afterwards)
gcode:
    {% set samples = params.SAMPLES | default(10) | int(0) %}
    {% set bed_temp = params.BED_TEMP | default(0) | float(-1) %}
    {% set ext_temp = params.EXTRUDER_TEMP | default(0) | float(-1) %}
    {% set cfg = printer.configfile.settings %}
    {% if printer.print_stats.state in ["printing", "paused"] %}
        {action_raise_error("Run Eddy probe accuracy with the printer idle")}
    {% endif %}
    {% if not 1 <= samples <= 50 %}
        {action_raise_error("SAMPLES must be 1..50")}
    {% endif %}
    {% if not 0 <= bed_temp < cfg.heater_bed.max_temp or not 0 <= ext_temp < cfg.extruder.max_temp %}
        {action_raise_error("BED_TEMP or EXTRUDER_TEMP is outside the heater limits")}
    {% endif %}
    {% if 'xyz' not in printer.toolhead.homed_axes %}
        G28
    {% endif %}
    BED_MESH_CLEAR
    G90
    G1 Z10 F600
    G1 X100 Y110 F3000
    {% if bed_temp > 0 %}
        M190 S{bed_temp}
    {% endif %}
    {% if ext_temp > 0 %}
        M109 S{ext_temp}
    {% endif %}
    PROBE_ACCURACY SAMPLES={samples}
    G1 Z10 F600
    {% if bed_temp > 0 %}
        M140 S0
    {% endif %}
    {% if ext_temp > 0 %}
        M104 S0
    {% endif %}

[gcode_macro EDDY_MESH]
description: Heat and build a full Eddy mesh (not saved). BED_TEMP (75), EXTRUDER_TEMP (260), PROFILE (eddy_<bed>_<nozzle>), METHOD (rapid_scan or automatic)
gcode:
    {% set bed_temp = params.BED_TEMP | default(75) | float(-1) %}
    {% set ext_temp = params.EXTRUDER_TEMP | default(260) | float(-1) %}
    {% set profile = params.PROFILE | default("eddy_%d_%d" % (bed_temp, ext_temp)) %}
    {% set method = params.METHOD | default("rapid_scan") | lower %}
    {% set cfg = printer.configfile.settings %}
    {% if printer.print_stats.state in ["printing", "paused"] %}
        {action_raise_error("Run Eddy mesh with the printer idle")}
    {% endif %}
    {% if not 0 <= bed_temp < cfg.heater_bed.max_temp or not cfg.extruder.min_extrude_temp <= ext_temp < cfg.extruder.max_temp %}
        {action_raise_error("BED_TEMP or EXTRUDER_TEMP is outside the heater limits")}
    {% endif %}
    {% if not profile.replace("_", "").replace("-", "").isalnum() %}
        {action_raise_error("PROFILE must contain only letters, digits, underscores or hyphens")}
    {% endif %}
    {% if method not in ["rapid_scan", "automatic"] %}
        {action_raise_error("METHOD must be rapid_scan or automatic")}
    {% endif %}
    BED_MESH_CLEAR
    M140 S{bed_temp}
    M104 S{ext_temp}
    G28
    G90
    G1 Z10 F600
    G1 X100 Y110 F3000
    M190 S{bed_temp}
    M109 S{ext_temp}
    BED_MESH_CALIBRATE PROFILE={profile} METHOD={method}
    M104 S0
    M140 S0
    G1 Z10 F600
    RESPOND MSG="Mesh '{profile}' built. Run SAVE_CONFIG to keep it (restarts Klipper)."

[gcode_macro EDDY_CALIBRATE]
description: Redo the Eddy height calibration with the paper test. Replaces saved data; requires CONFIRM=1
gcode:
    {% if printer.print_stats.state in ["printing", "paused"] %}
        {action_raise_error("Run Eddy calibration with the printer idle")}
    {% endif %}
    {% if params.CONFIRM | default(0) | int != 1 %}
        {action_raise_error("This replaces the saved Eddy height calibration. Run EDDY_CALIBRATE CONFIRM=1, do the paper test with TESTZ, then ACCEPT and SAVE_CONFIG")}
    {% endif %}
    BED_MESH_CLEAR
    G28
    G90
    G1 Z10 F600
    G1 X100 Y110 F3000
    RESPOND MSG="Starting Eddy height calibration: use TESTZ Z=-.1 / +.1 (or Z=--, Z=++) for the paper test, then ACCEPT and SAVE_CONFIG."
    PROBE_EDDY_CURRENT_CALIBRATE CHIP=btt_eddy

[gcode_macro EDDY_TEMP_CALIBRATE]
description: Start temperature-drift calibration to TARGET C (required). Replaces saved data; requires CONFIRM=1. Supervise it
gcode:
    {% set target = params.TARGET | default(0) | float(0) %}
    {% if printer.print_stats.state in ["printing", "paused"] %}
        {action_raise_error("Run Eddy temperature calibration with the printer idle")}
    {% endif %}
    {% if params.CONFIRM | default(0) | int != 1 or not 40 < target < 100 %}
        {action_raise_error("This replaces saved drift calibration. Run EDDY_TEMP_CALIBRATE TARGET=<probe C, 40-100> CONFIRM=1; then EDDY_TEMP_NEXT at each prompt, EDDY_TEMP_COMPLETE, SAVE_CONFIG")}
    {% endif %}
    {% if 'xyz' not in printer.toolhead.homed_axes %}
        G28
    {% endif %}
    TEMPERATURE_PROBE_CALIBRATE PROBE=btt_eddy TARGET={target}

[gcode_macro EDDY_TEMP_NEXT]
description: Advance Eddy temperature calibration to the next step (after the paper test)
gcode:
    TEMPERATURE_PROBE_NEXT

[gcode_macro EDDY_TEMP_COMPLETE]
description: Finish Eddy temperature calibration, then use SAVE_CONFIG
gcode:
    TEMPERATURE_PROBE_COMPLETE
