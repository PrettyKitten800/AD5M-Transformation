# Forge-X command conventions for upstream Klipper on the rebuilt AD5M.
# Reference: https://github.com/DrA1ex/ff5m/tree/daeadc39755c0750caca3999deed0e78394c167f
# Include with the commissioned printer configuration and mainsail.cfg.

[gcode_macro START_PRINT]
description: Heat, home, mesh the model area, and purge at the front-left
variable_commissioned: True
gcode:
    {% set extruder_temp = params.EXTRUDER_TEMP | default(-1) | float(-1) %}
    {% set bed_temp = params.BED_TEMP | default(-1) | float(-1) %}
    {% set extruder = printer.configfile.settings.extruder %}
    {% set bed = printer.configfile.settings.heater_bed %}
    {% if not commissioned %}
        {action_raise_error("Finish commissioning before enabling START_PRINT")}
    {% endif %}
    {% if not extruder.min_extrude_temp <= extruder_temp < extruder.max_temp %}
        {action_raise_error("Nozzle target %.1f C must be at least %.1f and below %.1f C" % (extruder_temp, extruder.min_extrude_temp, extruder.max_temp))}
    {% endif %}
    {% if not 0 <= bed_temp < bed.max_temp %}
        {action_raise_error("Bed target %.1f C is outside 0..<%.1f C; check the slicer filament preset" % (bed_temp, bed.max_temp))}
    {% endif %}
    {% if params.SKIP_LEVELING | default(0) | int or params.PURGE | default(1) | int != 1 %}
        {action_raise_error("START_PRINT requires fresh adaptive meshing and a purge line")}
    {% endif %}
    {% if "Z_OFFSET" in params or "SKIP_ZOFFSET" in params %}
        {action_raise_error("Use the calibrated probe Z offset")}
    {% endif %}
    # Check object geometry and purge clearance before any heat or motion.
    LINE_PURGE VALIDATE_ONLY=1
    M220 S100
    M221 S100
    _PRINTER_RESET_LIMITS
    _PRINTER_RESUME_SETUP
    BED_MESH_CLEAR
    SET_GCODE_OFFSET Z=0 MOVE=0
    G90
    M83
    G92 E0
    M140 S{bed_temp}
    M104 S{extruder_temp}
    G28
    # Clear the lower Z limit before applying compensation or moving across XY.
    G90
    G1 Z10 F600
    SMART_PARK
    M190 S{bed_temp}
    M109 S{extruder_temp}
    # Always measure at the requested bed AND nozzle printing temperatures.
    KAMP
    LINE_PURGE
    G90
    M83
    G92 E0

[gcode_macro END_PRINT]
description: Turn off heaters, lower the bed 30 mm, and park rear-right
gcode:
    TURN_OFF_HEATERS
    M107
    {% if printer.extruder.can_extrude %}
        _FX_FILAMENT_MOVE DISTANCE=-2 SPEED=300
    {% endif %}
    M220 S100
    M221 S100
    _PRINTER_RESET_LIMITS
    _FX_PARK_AT X={printer.toolhead.axis_maximum.x - 10} Y={printer.toolhead.axis_maximum.y - 10} LIFT=30
    M400
    BED_MESH_CLEAR
    _PRINTER_RESUME_SETUP

[gcode_macro SMART_PARK]
description: Park near the print area while the nozzle heats
gcode:
    {% set low = printer.toolhead.axis_minimum %}
    {% set high = printer.toolhead.axis_maximum %}
    {% set outlines = printer.exclude_object.objects | selectattr("polygon", "defined") | selectattr("polygon") | list %}
    {% set points = outlines | map(attribute="polygon") | sum(start=[]) %}
    {% set x = (low.x + high.x) / 2 %}
    {% set y = (low.y + high.y) / 2 %}
    {% if points %}
        {% set object_x = points | map(attribute=0) | min %}
        {% set object_y = points | map(attribute=1) | min %}
        {% if low.x <= object_x <= high.x and low.y <= object_y <= high.y %}
            {% set x = [object_x - 5, low.x + 5] | max %}
            {% set y = [object_y - 5, low.y + 5] | max %}
        {% endif %}
    {% endif %}
    _FX_PARK_AT X={x} Y={y} LIFT=5

[gcode_macro _FX_PARK_AT]
gcode:
    {% set t = printer.toolhead %}
    {% set low = t.axis_minimum %}
    {% set high = t.axis_maximum %}
    {% set x = params.X | float %}
    {% set y = params.Y | float %}
    {% set requested = params.LIFT | default(30) | float %}
    {% set available = high.z - t.position.z - 2.0 %}
    {% if requested < 0 or not low.x < x < high.x or not low.y < y < high.y %}
        {action_raise_error('Invalid parking position or bed drop')}
    {% endif %}
    {% if 'xyz' not in t.homed_axes %}
        {action_respond_info('Parking skipped: axes are not homed')}
    {% elif available < 0 %}
        {action_respond_info('Parking skipped: bed is at its lower travel limit')}
    {% else %}
        {% set drop = [requested, available] | min %}
        SAVE_GCODE_STATE NAME=fx_park
        M220 S100
        G91
        {% if drop > 0 %}
            G1 Z{drop} F600
        {% endif %}
        G1 X{x - t.position.x} Y{y - t.position.y} F3000
        M400
        RESTORE_GCODE_STATE NAME=fx_park
    {% endif %}

# Adapted from DrA1ex/ff5m KAMP/Line_Purge.cfg and KAMP_Settings.cfg.
# Source commit f64d0ad2a4325a86a4b5fbb22fa17b808de91a60 (GPL-3.0).
# Bed coordinates use the calibrated origin and configured travel limits.
[gcode_macro _FORGE_PURGE_SETTINGS]
variable_purge_height: 0.8
variable_tip_distance: 2.0
variable_purge_x: 15.0
variable_purge_y: 3.0
variable_purge_amount: 30.0
variable_line_length: 60.0
variable_flow_rate: 8.0
variable_retract: 0.5
gcode:

[gcode_macro LINE_PURGE]
description: Fixed front-left purge, retract, lift 0.5 mm, pause one second
gcode:
    {% set validate_only = params.VALIDATE_ONLY | default(0) | int %}
    {% set cfg = printer["gcode_macro _FORGE_PURGE_SETTINGS"] %}
    {% set objects = printer.exclude_object.objects %}
    {% set outlines = objects | selectattr("polygon", "defined") | selectattr("polygon") | list %}
    {% set points = outlines | map(attribute="polygon") | sum(start=[]) %}
    {% if not points or outlines | length != objects | length %}
        {action_raise_error("Missing object boundaries: enable Label objects and Exclude objects in Orca, then reslice and upload")}
    {% endif %}
    {% set low = printer.configfile.settings.bed_mesh.mesh_min %}
    {% set high = printer.configfile.settings.bed_mesh.mesh_max %}
    {% set limits = printer.configfile.settings.extruder %}
    {% set min_x = points | map(attribute=0) | min %}
    {% set max_x = points | map(attribute=0) | max %}
    {% set min_y = points | map(attribute=1) | min %}
    {% set max_y = points | map(attribute=1) | max %}
    {% set length = cfg.line_length | float %}
    {% set amount = cfg.purge_amount | float %}
    {% set x = cfg.purge_x | float %}
    {% set y = cfg.purge_y | float %}
    {% set machine_min = printer.toolhead.axis_minimum %}
    {% set machine_max = printer.toolhead.axis_maximum %}
    {% if min_x < machine_min.x or max_x > machine_max.x
          or min_y < machine_min.y or max_y > machine_max.y %}
        {action_raise_error("Model lies outside the printer XY travel limits")}
    {% endif %}
    # Purging is a nozzle move: use physical XY limits, not the smaller
    # probeable rectangle. The front-edge strip need not enlarge the mesh.
    {% if y < machine_min.y + 2 or y > machine_max.y - 2
          or x < machine_min.x + 2 or x + length > machine_max.x - 2 %}
        {action_raise_error("Fixed purge position lies outside the physical bed limits")}
    {% endif %}
    # Reserve the actual raised purge footprint plus clearance, rather than
    # excluding a 37 mm strip across the entire front of the plate.
    {% set pad = 2.0 %}
    {% for outline in outlines %}
        {% set poly = outline.polygon %}
        {% set ox_min = poly | map(attribute=0) | min %}
        {% set ox_max = poly | map(attribute=0) | max %}
        {% set oy_min = poly | map(attribute=1) | min %}
        {% set oy_max = poly | map(attribute=1) | max %}
        {% if ox_max >= x - pad and ox_min <= x + length + pad
              and oy_max >= y - pad and oy_min <= y + pad %}
            {action_raise_error("Model overlaps fixed purge strip X%.1f..%.1f Y%.1f..%.1f; move the model clear of that strip" % (x-pad, x+length+pad, y-pad, y+pad))}
        {% endif %}
    {% endfor %}
    {% if not 0 < amount <= limits.max_extrude_only_distance or length <= 0
          or not 0 <= cfg.tip_distance <= limits.max_extrude_only_distance
          or not 0 < cfg.purge_height <= 2 or not 0 < cfg.flow_rate <= 10 %}
        {action_raise_error("Invalid Forge purge settings")}
    {% endif %}
    {% set filament_area = 3.14159265359 * (limits.filament_diameter / 2) ** 2 %}
    {% set cross_section = amount * filament_area / length %}
    {% if cross_section > limits.max_extrude_cross_section %}
        {action_raise_error("Lengthen the purge line to stay within the extruder cross-section limit")}
    {% endif %}
    {% set feed = cfg.flow_rate / cross_section * 60 %}
    {% if not validate_only %}
        {% if "xyz" not in printer.toolhead.homed_axes or not printer.extruder.can_extrude %}
            {action_raise_error("LINE_PURGE requires homed axes and a hot nozzle")}
        {% endif %}
        {action_respond_info("Forge purge at X%.2f Y%.2f Z%.2f: %.1f mm filament over %.1f mm, %.1f mm3/s" % (x, y, cfg.purge_height, amount, length, cfg.flow_rate))}
        SAVE_GCODE_STATE NAME=fx_purge
        _FX_PARK_AT X={x} Y={y} LIFT=5
        G90
        M83
        G92 E0
        G1 Z{cfg.purge_height} F300
        G1 E{cfg.tip_distance} F180
        G1 X{x + length} E{amount} F{feed}
        G1 E{0.0 - cfg.retract} F600
        G1 Z{cfg.purge_height + 0.5} F600
        G4 P1000
        G1 Z2 F600
        G1 E{cfg.retract} F300
        M400
        RESTORE_GCODE_STATE NAME=fx_purge
    {% endif %}

[gcode_macro KAMP]
description: Probe a native Klipper adaptive mesh around the sliced objects
gcode:
    {% if "xyz" not in printer.toolhead.homed_axes %}
        {action_raise_error("KAMP requires homed XYZ axes")}
    {% endif %}
    {% set objects = printer.exclude_object.objects %}
    {% set outlines = objects | selectattr("polygon", "defined") | selectattr("polygon") | list %}
    {% if not outlines or outlines | length != objects | length %}
        {action_raise_error("KAMP needs sliced object boundaries; enable Orca object labels and reslice")}
    {% endif %}
    # Fixed front-left purge is outside the model mesh. Klipper extends the
    # nearest mesh edge beyond its boundary; retain the raised Z0.8 purge.
    # Eddy Duo rapid scan (non-contact, on-the-fly, Cartographer-style).
    BED_MESH_CALIBRATE ADAPTIVE=1 ADAPTIVE_MARGIN=5 METHOD=rapid_scan

[gcode_macro AUTO_FULL_BED_LEVEL]
description: Heat the bed and build a full mesh without automatically saving it
gcode:
    {% set temp = params.BED_TEMP | default(75) | float(-1) %}
    {% set profile = params.PROFILE | default("auto") %}
    {% if printer.print_stats.state in ["printing", "paused"] %}
        {action_raise_error("Run full bed leveling with the printer idle")}
    {% endif %}
    {% if not 0 <= temp < printer.configfile.settings.heater_bed.max_temp %}
        {action_raise_error("Invalid BED_TEMP")}
    {% endif %}
    {% if not profile.replace("_", "").replace("-", "").isalnum() %}
        {action_raise_error("PROFILE must contain only letters, digits, underscores or hyphens")}
    {% endif %}
    TURN_OFF_HEATERS
    BED_MESH_CLEAR
    G28
    M190 S{temp}
    BED_MESH_CALIBRATE PROFILE={profile}
    M140 S0
    RESPOND MSG="Use SAVE_CONFIG if you want to keep this mesh"

[gcode_macro BED_LEVEL_SCREWS_TUNE]
description: Measure bed screw tilt with 3 samples per corner by default (optional SAMPLES=3)
gcode:
    {% set samples = params.SAMPLES | default(3) | int %}
    {% if printer.configfile.settings.screws_tilt_adjust is not defined %}
        {action_raise_error("Measure and configure the AD5M bed screw positions first")}
    {% endif %}
    {% if printer.print_stats.state in ["printing", "paused"] %}
        {action_raise_error("Run screw tilt adjustment with the printer idle")}
    {% endif %}
    BED_MESH_CLEAR
    G28
    SCREWS_TILT_CALCULATE SAMPLES={samples}


[gcode_macro _TUNE2_DATA]
variable_c1_z1: 0.0
variable_c2_z1: 0.0
variable_c3_z1: 0.0
variable_c4_z1: 0.0
variable_c1_z2: 0.0
variable_c2_z2: 0.0
variable_c3_z2: 0.0
variable_c4_z2: 0.0
gcode:

[gcode_macro BED_LEVEL_SCREWS_TUNE2]
description: Measure bed screw tilt across 3 complete cycles (1 tap per corner per cycle) and calculate average adjustments
gcode:
    {% if printer.configfile.settings.screws_tilt_adjust is not defined %}
        {action_raise_error("Measure and configure the AD5M bed screw positions first")}
    {% endif %}
    {% if printer.print_stats.state in ["printing", "paused"] %}
        {action_raise_error("Run screw tilt adjustment with the printer idle")}
    {% endif %}
    BED_MESH_CLEAR
    {% if 'xyz' not in printer.toolhead.homed_axes %}
        G28
    {% endif %}
    RESPOND MSG="=== [Cycle 1/3] Measuring each corner (pass 1) ==="
    SCREWS_TILT_CALCULATE SAMPLES=1
    _TUNE2_PASS2

[gcode_macro _TUNE2_PASS2]
gcode:
    {% set s = printer.screws_tilt_adjust.results %}
    SET_GCODE_VARIABLE MACRO=_TUNE2_DATA VARIABLE=c1_z1 VALUE={s.screw1.z}
    SET_GCODE_VARIABLE MACRO=_TUNE2_DATA VARIABLE=c2_z1 VALUE={s.screw2.z}
    SET_GCODE_VARIABLE MACRO=_TUNE2_DATA VARIABLE=c3_z1 VALUE={s.screw3.z}
    SET_GCODE_VARIABLE MACRO=_TUNE2_DATA VARIABLE=c4_z1 VALUE={s.screw4.z}
    RESPOND MSG="=== [Cycle 2/3] Measuring each corner (pass 2) ==="
    SCREWS_TILT_CALCULATE SAMPLES=1
    _TUNE2_PASS3

[gcode_macro _TUNE2_PASS3]
gcode:
    {% set s = printer.screws_tilt_adjust.results %}
    SET_GCODE_VARIABLE MACRO=_TUNE2_DATA VARIABLE=c1_z2 VALUE={s.screw1.z}
    SET_GCODE_VARIABLE MACRO=_TUNE2_DATA VARIABLE=c2_z2 VALUE={s.screw2.z}
    SET_GCODE_VARIABLE MACRO=_TUNE2_DATA VARIABLE=c3_z2 VALUE={s.screw3.z}
    SET_GCODE_VARIABLE MACRO=_TUNE2_DATA VARIABLE=c4_z2 VALUE={s.screw4.z}
    RESPOND MSG="=== [Cycle 3/3] Measuring each corner (pass 3) ==="
    SCREWS_TILT_CALCULATE SAMPLES=1
    _TUNE2_FINISH

[gcode_macro _TUNE2_FINISH]
gcode:
    {% set d = printer["gcode_macro _TUNE2_DATA"] %}
    {% set s = printer.screws_tilt_adjust.results %}
    {% set c1_z3 = s.screw1.z %}
    {% set c2_z3 = s.screw2.z %}
    {% set c3_z3 = s.screw3.z %}
    {% set c4_z3 = s.screw4.z %}
    
    {% set c1_avg = (d.c1_z1 + d.c1_z2 + c1_z3) / 3.0 %}
    {% set c2_avg = (d.c2_z1 + d.c2_z2 + c2_z3) / 3.0 %}
    {% set c3_avg = (d.c3_z1 + d.c3_z2 + c3_z3) / 3.0 %}
    {% set c4_avg = (d.c4_z1 + d.c4_z2 + c4_z3) / 3.0 %}
    
    {% set pitch = 0.70 %}
    
    RESPOND MSG="================ 3-CYCLE AVERAGE BED TRAM RESULTS ================"
    RESPOND MSG="front left screw (base) : avg z={ '%.5f' % c1_avg } [C1: { '%.4f' % d.c1_z1 }, C2: { '%.4f' % d.c1_z2 }, C3: { '%.4f' % c1_z3 }]"
    
    {% for item in [
        ("front right screw", c2_avg, d.c2_z1, d.c2_z2, c2_z3),
        ("rear right screw ", c3_avg, d.c3_z1, d.c3_z2, c3_z3),
        ("rear left screw  ", c4_avg, d.c4_z1, d.c4_z2, c4_z3)
    ] %}
        {% set name = item[0] %}
        {% set avg = item[1] %}
        {% set z1 = item[2] %}
        {% set z2 = item[3] %}
        {% set z3 = item[4] %}
        {% set diff = c1_avg - avg %}
        {% set turns = diff / pitch %}
        {% set sign = "CW" if turns >= 0 else "CCW" %}
        {% set abs_turns = turns | abs %}
        {% set full_turns = abs_turns | int %}
        {% set mins = ((abs_turns - full_turns) * 60) | round | int %}
        {% if mins == 60 %}
            {% set full_turns = full_turns + 1 %}
            {% set mins = 0 %}
        {% endif %}
        RESPOND MSG="{ name } : avg z={ '%.5f' % avg } [C1: { '%.4f' % z1 }, C2: { '%.4f' % z2 }, C3: { '%.4f' % z3 }] : adjust { sign } { '%02d:%02d' % (full_turns, mins) }"
    {% endfor %}
    RESPOND MSG="=================================================================="

[gcode_macro LOAD_FILAMENT]
description: Feed filament through a preheated nozzle
gcode:
    _FX_FILAMENT_MOVE DISTANCE={params.LENGTH | default(40) | float(0) | abs} SPEED={params.SPEED | default(300) | float(0)}

[gcode_macro UNLOAD_FILAMENT]
description: Retract filament from a preheated nozzle
gcode:
    _FX_FILAMENT_MOVE DISTANCE={0.0 - (params.LENGTH | default(40) | float(0) | abs)} SPEED={params.SPEED | default(300) | float(0)}

[gcode_macro PURGE_FILAMENT]
description: Extrude filament through a preheated nozzle
gcode:
    _FX_FILAMENT_MOVE DISTANCE={params.LENGTH | default(20) | float(0) | abs} SPEED={params.SPEED | default(300) | float(0)}

[gcode_macro _FX_FILAMENT_MOVE]
gcode:
    {% set distance = params.DISTANCE | float(0) %}
    {% set speed = params.SPEED | float(0) %}
    {% set limits = printer.configfile.settings.extruder %}
    {% if not printer.extruder.can_extrude %}
        {action_raise_error("Heat the nozzle before moving filament")}
    {% endif %}
    {% if not 0 < (distance | abs) <= limits.max_extrude_only_distance
          or not 0 < speed <= limits.max_extrude_only_velocity * 60 %}
        {action_raise_error("Filament distance or feed rate exceeds the extruder limits")}
    {% endif %}
    SAVE_GCODE_STATE NAME=fx_filament
    M83
    G1 E{distance} F{speed}
    M400
    RESTORE_GCODE_STATE NAME=fx_filament

[gcode_macro LOAD_MATERIAL]
description: Open the filament handling prompt in Fluidd
gcode:
    {% if printer.print_stats.state == "printing" and not printer.pause_resume.is_paused %}
        {action_raise_error("Pause the print before opening filament controls")}
    {% endif %}
    RESPOND TYPE=command MSG="action:prompt_begin Filament controls"
    RESPOND TYPE=command MSG="action:prompt_text Preheat the nozzle for your filament, then select an action."
    RESPOND TYPE=command MSG="action:prompt_button Load|LOAD_FILAMENT|primary"
    RESPOND TYPE=command MSG="action:prompt_button Unload|UNLOAD_FILAMENT|primary"
    RESPOND TYPE=command MSG="action:prompt_button Purge|PURGE_FILAMENT|primary"
    {% if printer.pause_resume.is_paused %}
        RESPOND TYPE=command MSG="action:prompt_footer_button Resume|_FX_RESUME|primary"
    {% endif %}
    RESPOND TYPE=command MSG="action:prompt_show"

[gcode_macro M600]
description: Pause for a filament change
gcode:
    {% if printer.print_stats.state != "printing" or printer.pause_resume.is_paused %}
        {action_raise_error("M600 requires an active print")}
    {% endif %}
    PAUSE {rawparams}
    M400
    LOAD_MATERIAL

[gcode_macro _FX_RESUME]
gcode:
    RESPOND TYPE=command MSG="action:prompt_end"
    RESUME

[gcode_macro PID_TUNE_BED]
description: Tune bed temperature control without saving automatically
gcode:
    _FX_PID_TUNE HEATER=heater_bed TEMPERATURE={params.TEMPERATURE | default(75) | float(-1)}

[gcode_macro M357]
description: Forge-X shortcut for bed PID calibration
gcode:
    PID_TUNE_BED TEMPERATURE={params.E | default(75) | float(-1)}

[gcode_macro PID_TUNE_EXTRUDER]
description: Tune hotend temperature control without saving automatically
gcode:
    _FX_PID_TUNE HEATER=extruder TEMPERATURE={params.TEMPERATURE | default(240) | float(-1)}

[gcode_macro _FX_PID_TUNE]
gcode:
    {% set heater = params.HEATER %}
    {% set limits = printer.configfile.settings[heater] %}
    {% set temp = params.TEMPERATURE | float(-1) %}
    {% if printer.print_stats.state in ["printing", "paused"] %}
        {action_raise_error("Run PID calibration with the printer idle")}
    {% endif %}
    {% if not ([25, limits.min_temp] | max) < temp < limits.max_temp %}
        {action_raise_error("PID temperature is outside the heater limits")}
    {% endif %}
    TURN_OFF_HEATERS
    PID_CALIBRATE HEATER={heater} TARGET={temp}

[gcode_macro ZSHAPER]
description: Run Klipper input shaper calibration on the assembled toolhead
gcode:
    {% set axis = params.AXIS | default("") | upper %}
    {% if printer.print_stats.state in ["printing", "paused"] %}
        {action_raise_error("Run input shaper calibration with the printer idle")}
    {% endif %}
    {% if axis not in ["", "X", "Y"] %}
        {action_raise_error("AXIS must be X or Y")}
    {% endif %}
    TURN_OFF_HEATERS
    G28
    {% if axis %}
        SHAPER_CALIBRATE AXIS={axis}
    {% else %}
        SHAPER_CALIBRATE
    {% endif %}

[gcode_macro WAIT]
description: Wait for TIME milliseconds and finish queued moves
gcode:
    {% set duration = params.TIME | default(1) | float(-1) %}
    {% if not 0 <= duration <= 600000 %}
        {action_raise_error("TIME must be between 0 and 600000 milliseconds")}
    {% endif %}
    G4 P{duration}
    M400
