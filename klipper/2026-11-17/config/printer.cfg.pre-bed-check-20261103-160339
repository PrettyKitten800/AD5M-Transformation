# Flashforge AD5M rebuild - CAN AND INPUT CHECKS
# Input checks only. No heater, motor, or fan outputs are configured.
# Do not replace this with either guide's complete config unchanged.
# Reference review: /home/curby/printer-rebuild/README.md

[include mainsail.cfg]

[mcu]
canbus_uuid: c16b9f102b59
canbus_interface: can0

[mcu head]
canbus_uuid: 29108b186b2d
canbus_interface: can0

[printer]
kinematics: none
max_velocity: 50
max_accel: 500

[temperature_sensor Raspberry_Pi_5]
sensor_type: temperature_host

[exclude_object]

# Temporary input checks. Verify trigger polarity before using these for homing.
[gcode_button check_z_endstop]
pin: ^PG10
press_gcode:
    RESPOND MSG="Lower Z endstop: PRESSED"
release_gcode:
    RESPOND MSG="Lower Z endstop: RELEASED"

[gcode_button check_bed_probe]
pin: !PG6
press_gcode:
    RESPOND MSG="Bed probe: PRESSED"
release_gcode:
    RESPOND MSG="Bed probe: RELEASED"
