# Flashforge AD5M rebuild - CAN, SENSOR AND MOTOR CHECKS
# Individual motor checks only. No heater or fan outputs are configured.
# Do not replace this with either guide's complete config unchanged.
# Reference review: /home/curby/printer-rebuild/README.md

[include mainsail.cfg]
[include bed-temperature-check.cfg]
[include motor-check.cfg]

[mcu]
canbus_uuid: c16b9f102b59
canbus_interface: can0

[mcu head]
canbus_uuid: 29108b186b2d
canbus_interface: can0

[printer]
kinematics: none
max_velocity: 50
max_accel: 500

[temperature_sensor Raspberry_Pi_5]
sensor_type: temperature_host

[exclude_object]

# Temporary input checks. Verify trigger polarity before using these for homing.
[gcode_button check_z_endstop]
pin: ^PG10
press_gcode:
    RESPOND MSG="Lower Z endstop: PRESSED"
release_gcode:
    RESPOND MSG="Lower Z endstop: RELEASED"

[gcode_button check_bed_probe]
pin: !PG6
press_gcode:
    RESPOND MSG="Bed probe: PRESSED"
release_gcode:
    RESPOND MSG="Bed probe: RELEASED"

# Provisional curve for a room-temperature sanity check only.
[temperature_sensor hotend_check]
sensor_type: Generic 3950
sensor_pin: head:PA3
pullup_resistor: 4700
min_temp: 0
max_temp: 120

# Read the EBB36 onboard accelerometer without commanding printer movement.
[adxl345]
cs_pin: head:PB12
spi_bus: spi2_PB2_PB11_PB10

# STOP4 input check. Confirm polarity by inserting and removing filament.
[filament_switch_sensor runout_sensor]
switch_pin: !PG12
pause_on_runout: False
