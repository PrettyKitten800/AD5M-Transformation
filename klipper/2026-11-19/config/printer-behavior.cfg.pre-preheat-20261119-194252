# AD5M user behavior. Mainsail/Fluidd client hooks; upstream mainsail.cfg stays maintained.
# Requested park: bed down 30 mm, rear-right 10 mm inside each XY endstop.
[gcode_macro _CLIENT_VARIABLE]
variable_use_custom_pos: True
variable_custom_park_x: 209.7
variable_custom_park_y: 210.0
variable_custom_park_dz: 30.0
variable_retract: 1.0
variable_cancel_retract: 2.0
variable_speed_retract: 10.0
variable_speed_unretract: 5.0
variable_speed_hop: 10.0
variable_speed_move: 50.0
# Our cancel hook parks after the upstream routine turns heaters off.
variable_park_at_cancel: False
variable_user_pause_macro: "_PRINTER_PAUSE_SETUP"
variable_user_resume_macro: "_PRINTER_RESUME_SETUP"
variable_user_cancel_macro: "_PRINTER_CANCEL_CLEANUP"
gcode:

[gcode_macro _PRINTER_PAUSE_SETUP]
variable_parked: False
variable_saved_temperature: {'restore': False, 'temp': 0.0}
gcode:
    {% set t = printer.toolhead %}
    {% set available = t.axis_maximum.z - t.position.z - 2.0 %}
    {% set can_park = 'xyz' in t.homed_axes and available >= 0 and not parked %}
    {% set drop = [30.0, available] | min if can_park else 0.0 %}
    {% set x = t.axis_maximum.x - 10.0 if can_park else printer.gcode_move.gcode_position.x %}
    {% set y = t.axis_maximum.y - 10.0 if can_park else printer.gcode_move.gcode_position.y %}
    {% set temp = saved_temperature if parked else printer['gcode_macro RESUME'].last_extruder_temp %}
    SET_GCODE_VARIABLE MACRO=_CLIENT_VARIABLE VARIABLE=custom_park_x VALUE={x}
    SET_GCODE_VARIABLE MACRO=_CLIENT_VARIABLE VARIABLE=custom_park_y VALUE={y}
    SET_GCODE_VARIABLE MACRO=_CLIENT_VARIABLE VARIABLE=custom_park_dz VALUE={drop}
    SET_GCODE_VARIABLE MACRO=_CLIENT_VARIABLE VARIABLE=retract VALUE={0.0 if parked else 1.0}
    SET_GCODE_VARIABLE MACRO=_PRINTER_PAUSE_SETUP VARIABLE=saved_temperature VALUE="{temp}"
    SET_GCODE_VARIABLE MACRO=RESUME VARIABLE=last_extruder_temp VALUE="{temp}"
    SET_GCODE_VARIABLE MACRO=RESUME VARIABLE=idle_state VALUE={temp.restore}
    SET_GCODE_VARIABLE MACRO=_PRINTER_PAUSE_SETUP VARIABLE=parked VALUE=True
    {% if not can_park and not parked %}
        {action_respond_info('Pause park limited by homing state or remaining Z travel')}
    {% endif %}

[gcode_macro _PRINTER_RESUME_SETUP]
gcode:
    SET_GCODE_VARIABLE MACRO=_PRINTER_PAUSE_SETUP VARIABLE=parked VALUE=False
    SET_GCODE_VARIABLE MACRO=_CLIENT_VARIABLE VARIABLE=retract VALUE=1.0
    SET_GCODE_VARIABLE MACRO=RESUME VARIABLE=idle_state VALUE=False
    RESPOND TYPE=command MSG="action:prompt_end"

[gcode_macro _PRINTER_CANCEL_CLEANUP]
gcode:
    TURN_OFF_HEATERS
    M107
    M220 S100
    M221 S100
    _PRINTER_RESET_LIMITS
    {% if not printer.pause_resume.is_paused %}
        _FX_PARK_AT X={printer.toolhead.axis_maximum.x - 10} Y={printer.toolhead.axis_maximum.y - 10} LIFT=30
    {% endif %}
    M400
    BED_MESH_CLEAR
    _PRINTER_RESUME_SETUP

[gcode_macro PARK_HEAD]
description: Lower the bed 30 mm and park at the rear-right
gcode:
    {% if printer.print_stats.state == 'printing' and not printer.pause_resume.is_paused %}
        {action_raise_error('Pause the print before parking')}
    {% endif %}
    _FX_PARK_AT X={printer.toolhead.axis_maximum.x - 10} Y={printer.toolhead.axis_maximum.y - 10} LIFT={params.DROP | default(30) | float}

[gcode_macro _PRINTER_IDLE]
gcode:
    {% if printer.pause_resume.is_paused %}
        # Preserve the bed and motor position so resume is still possible.
        SET_HEATER_TEMPERATURE HEATER=extruder TARGET=0
        SET_GCODE_VARIABLE MACRO=RESUME VARIABLE=idle_state VALUE=True
    {% else %}
        TURN_OFF_HEATERS
        M107
        M84
    {% endif %}

[gcode_macro _PRINTER_RESET_LIMITS]
description: Restore configured motion limits after a per-job speed trial
gcode:
    {% set cfg = printer.configfile.settings.printer %}
    SET_VELOCITY_LIMIT VELOCITY={cfg.max_velocity | default(100)} ACCEL={cfg.max_accel | default(1500)} SQUARE_CORNER_VELOCITY={cfg.square_corner_velocity | default(5)} MINIMUM_CRUISE_RATIO={cfg.minimum_cruise_ratio | default(0.5)}
